package service;

@lombok.ToString
public abstract class Duck {
    public void quack() {
        System.out.println("El pato hace QUACK");
    }

    public void swim() {
        System.out.println("El pato puede nadar");
    }

    public void fly() {
        System.out.println("El pato puede volar");
    }

    public void display() {
        System.out.println("Hola soy un Pato Corriente :)");
    }
}

